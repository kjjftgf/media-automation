# 环境变量模板 — 复制为 .env 并填写真实值
# ⚠️ 本文件不含任何真实凭据

# ── 飞书开放平台 ──
FEISHU_APP_ID=
FEISHU_APP_SECRET=
BITABLE_APP_TOKEN=
FEISHU_RECORD_ID=
FEISHU_TABLE_TV=

# ── CloudSaver 搜索服务 ──
CLOUDSAVER_HOST=127.0.0.1:8008
CLOUDSAVER_PORT=8008
CLOUDSAVER_ADMIN_CODE=

# ── PanSou 搜索服务 ──
PANSOU_BASE=http://127.0.0.1:8888
PANSOU_HOST=127.0.0.1:8888

# ── SearXNG 交叉验证 ──
SEARXNG_HOST=127.0.0.1:8080

# ── CASX 任务系统 ──
CASX_HOST=127.0.0.1:5115
CASX_ADMIN_PASSWORD=

# ── 夸克云盘 ──
# 注意: 夸克 cookie 通常从 CASX 数据库读取，不在此配置
# 如需独立使用，可自行添加: QUARK_COOKIE=
